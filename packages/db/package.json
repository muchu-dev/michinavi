{
  "name": "@michinavi/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "start": "supabase start",
    "stop": "supabase stop",
    "status": "supabase status",
    "reset": "supabase db reset",
    "diff": "supabase db diff",
    "migration:new": "supabase migration new",
    "types": "supabase gen types typescript --local --schema public > src/database.types.ts && biome format --write src/database.types.ts"
  },
  "dependencies": {
    "@supabase/ssr": "catalog:",
    "@supabase/supabase-js": "catalog:"
  },
  "devDependencies": {
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:"
  }
}
