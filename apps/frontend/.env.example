NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# AppEnv: production / preview / local
APP_ENV="local"

# ローカル開発で認証済み画面だけを確認するときのみ true にする
DEV_AUTH_BYPASS="false"

# Google AI Studio で発行した Gemini API キー。サーバー側のみで読む（NEXT_PUBLIC_ を付けない）
GEMINI_API_KEY=""

# RLS を迂回する service role キー。`supabase status` から取得する。
# ローカル用の鍵であり、本番の値をここに書かない
SUPABASE_SECRET_KEY=""
